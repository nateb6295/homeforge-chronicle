#!/bin/bash
# opus-session — persistent interactive Claude Code session in tmux

WORK_DIR="$HOME/chronicle"
LOG_FILE="$WORK_DIR/opus-session.log"
BOOT_FILE="$WORK_DIR/opus-boot-prompt.txt"

cd "$WORK_DIR"

source "$WORK_DIR/chronicle.env" 2>/dev/null || true

notify() {
    [ -n "${OPUS_WEBHOOK:-}" ] && \
    curl -s -X POST -H "Content-Type: application/json" \
        -H "User-Agent: opus-session/2.0" \
        -d "{\"content\": \"$1\"}" \
        "$OPUS_WEBHOOK" > /dev/null 2>&1 || true
}

while true; do
    echo "$(date -Iseconds) Starting Opus session" >> "$LOG_FILE"
    notify "Opus session starting."

    unset CLAUDECODE 2>/dev/null || true

    python3 "$WORK_DIR/bin/generate_boot_prompt.py" 2>/dev/null || \
        echo "Session starting. Read ~/chronicle/CLAUDE.md and ~/chronicle/values.md. Then find your own direction." > "$BOOT_FILE"

    # Log session_start event for time-to-first-action measurement
    sqlite3 /mnt/hdd/chronicle-data/processed.db \
        "INSERT INTO activity_feed (created_at, source, activity_type, content) VALUES (strftime('%s','now'), 'opus:session_start', 'system', 'Opus session started. Boot prompt loaded.');" \
        2>/dev/null || true

    claude \
        --model claude-opus-4-6 \
        --dangerously-skip-permissions \
        --allowedTools "Bash Read Write Edit Grep Glob WebSearch WebFetch mcp__chronicle-memory__*" &
    CLAUDE_PID=$!

    sleep 5

    # Inject boot prompt via tmux buffer
    tmux load-buffer -b boot "$BOOT_FILE" 2>/dev/null
    tmux paste-buffer -b boot -t opus -d 2>/dev/null
    sleep 0.5
    tmux send-keys -t opus Enter 2>/dev/null

    wait $CLAUDE_PID
    EXIT_CODE=$?

    echo "$(date -Iseconds) Opus exited (code $EXIT_CODE)" >> "$LOG_FILE"
    notify "Opus session exited (code $EXIT_CODE). Restarting in 30s."

    sleep 30
done
