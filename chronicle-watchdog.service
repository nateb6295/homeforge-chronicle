[Unit]
Description=Chronicle Watchdog — Mind behavior monitor
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/chronicle/bin/chronicle_watchdog.py
Environment=CHRONICLE_DB=%h/.homeforge-chronicle/processed.db
Environment=WATCHDOG_INTERVAL=120
Environment=WATCHDOG_LOG=%h/chronicle/chronicle-watchdog.log
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
