def run_cycle(db: DB) -> bool:
    """Run one provocateur cycle. Returns True if something was produced."""
    # Analyze any new Nate captures
    _analyze_nate_captures(db)

    # Ada reviews open predictions against recent evidence (~hourly)
    _ada_prediction_review(db)

    # Check Ada's inbox for directed voices from Opus
    try:
        from agent_voice import Voice as _AV
        import sqlite3 as _sq2
        _inbox_conn = _sq2.connect(DB_PATH, timeout=10)
        _inbox_conn.row_factory = _sq2.Row
        _ada_v = _AV(_inbox_conn, "ada")
        _ada_inbox = _ada_v.read_inbox()
        for msg in _ada_inbox:
            log(f"  Ada inbox from {msg.get('agent','?')}: {str(msg.get('content',''))[:100]}")
        _inbox_conn.close()
    except Exception:
        pass

    # Read swarm feedback
    try:
        feedback = _read_and_ack_feedback_raw("provocateur")
        for fb in feedback:
            log(f"  Family says: {fb['content'][:80]}")
    except Exception:
        pass

    material = get_recent_material(db)

    if not material["briefs"]:
        log("  No recent material to work with")
        return False

    log(f"  Working with {len(material['briefs'])} raw articles")

    # Generate provocation
    provocation = generate_provocation(material)
    if not provocation:
        log("  No provocation generated (SKIP or error)")
        return False

    mode = provocation["mode"]
    text = provocation["text"]
    synthesis_type = provocation.get("synthesis_type")
    if synthesis_type:
        log(f"  [{mode}/{synthesis_type}] {safe_truncate(text, 120)}")
    else:
        log(f"  [{mode}] {safe_truncate(text, 120)}")

    # Maybe generate an image (50% chance per cycle when enabled)
    image_path = None
    if ENABLE_IMAGES and random.random() < 0.5:
        img_prompt = generate_image_prompt(text)
        if img_prompt:
            log(f"  Image prompt: {safe_truncate(img_prompt, 80)}")
            ts = datetime.now().strftime("%Y%m%d_%H%M%S")
            image_path = generate_image(img_prompt, f"provocateur_{ts}.png")

    # Store in scratch_pad for Opus
    type_tag = f"/{synthesis_type}" if synthesis_type else ""
    note = f"[Provocateur/{mode}{type_tag}] {text}"
    if image_path:
        note += f"\n\n[Image: {image_path}]"

    db.run(
        "INSERT INTO scratch_pad (content, category, priority, resolved, created_at, updated_at) "
        "VALUES (?, 'provocateur', 8, 0, ?, ?)",
        (note, now_ts(), now_ts()),
    )

    # Log thread-relevant output to thread_history
    if mode in ("thread_challenge", "thread_boundary"):
        _thread = _load_active_thread_raw()
        if _thread:
            try:
                db.run(
                    "INSERT INTO thread_history (thread_id, event_type, content, source, created_at) "
                    "VALUES (?, 'challenge', ?, 'provocateur', ?)",
                    (_thread["id"], safe_truncate(text, 500), now_ts())
                )
            except Exception as e:
                log(f"  Thread history write error: {e}")

    # Log to activity feed
    db.log_activity(
        mode,
        f"Provocateur [{mode}]: {safe_truncate(text, 120)}",
        note,
        json.dumps({
            "mode": mode,
            "synthesis_type": synthesis_type,
            "image": image_path,
            "articles_available": len(material["briefs"]),
            "connections_available": len(material["connections"]),
        }),
    )

    if _mesh:
        _mesh.pulse("provocations_produced")

    # Llama reflects on what was produced
    _llama_reflect(db, mode, text, len(material["briefs"]))

    # Post to Discord #mind
    mode_emoji = {"contrarian": "devil", "synthesis": "thread"}
    type_label = f" [{synthesis_type}]" if synthesis_type else ""
    discord_msg = f"**Provocateur** [{mode}]{type_label}\n\n{text}"
    post_to_discord(discord_msg, image_path)

    return True


def main():
    log("═══ Provocateur Agent starting ═══")

    # Initialize capture cursor
    global _last_capture_id
    try:
        import sqlite3 as _sq
        _conn = _sq.connect(DB_PATH, timeout=10)
        _row = _conn.execute("SELECT MAX(id) FROM activity_feed WHERE source='operator:capture'").fetchone()
        _last_capture_id = (_row[0] or 0) - 5  # Start from last 5 captures
        _conn.close()
    except Exception:
        _last_capture_id = 0
    log(f"DB: {DB_PATH}")
    log(f"Ollama: {OLLAMA_URL} (model: {SYNTH_MODEL})")
    log(f"Cycle: {CYCLE_INTERVAL}s | Lookback: {LOOKBACK_HOURS}h")
    log(f"Images: {'enabled' if ENABLE_IMAGES else 'disabled'} → {IMAGE_DIR}")

    os.makedirs(IMAGE_DIR, exist_ok=True)
    db = DB(DB_PATH)

    global _mesh
    _mesh = Mesh("provocateur", db_path=DB_PATH)
    _mesh.expect("provocations_produced", min_per_hour=1)
    log("Mesh node joined")

    # Graceful shutdown
    running = True
    def _stop(sig, frame):
        nonlocal running
        log("Shutting down...")
        running = False
    signal.signal(signal.SIGTERM, _stop)
    signal.signal(signal.SIGINT, _stop)

    cycle = 0

    while running:
        cycle += 1
        log(f"── Cycle {cycle} ──")
        # Sovereignty jitter: occasionally skip a cycle to break timing fingerprints (Thread #195)
        if random.random() < CYCLE_SKIP_RATE:
            _skip_sleep = random.randint(CYCLE_INTERVAL // 2, CYCLE_INTERVAL * 2)
            log(f"  Cycle {cycle} skipped (sovereignty jitter, sleeping {_skip_sleep}s)")
            for _ in range(_skip_sleep // 5):
                if not running:
                    break
                time.sleep(5)
            continue
        try:
            produced = run_cycle(db)
            log(f"  Cycle {cycle} complete: {'produced' if produced else 'quiet'}")
        except Exception as e:
            log(f"Cycle error: {e}")
            import traceback
            traceback.print_exc()

        # Sleep in short intervals for clean shutdown
        _jitter_secs = int(CYCLE_INTERVAL * 0.2 * (2 * __import__('random').random() - 1))  # ±20% jitter
        for _ in range((CYCLE_INTERVAL + _jitter_secs) // 5):
            if not running:
                break
            time.sleep(5)

    _mesh.shutdown()
    db.close()
    log("═══ Provocateur Agent stopped ═══")


if __name__ == "__main__":
    main()
