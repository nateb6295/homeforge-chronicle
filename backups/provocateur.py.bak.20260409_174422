                "- Name it. State why it is likely wrong. Give a concrete counter-example from history, science, or philosophy\n"
                "- If you cannot find a fatal flaw, say SKIP. Do not manufacture weak objections\n"
                "- 2-4 sentences. No filler. No hedging. No 'it is worth noting'\n"
                "- Do NOT reference any internal system, project, or infrastructure\n"
                "- Write like you are being paid per insight, not per word"
                + _skills_block
            ),
            "user": f"Thesis:\n{thesis_text}\n\n" + (f"Recent evidence:\n{thread_context}\n\n" if thread_context else "") + f"What is the weakest point in this specific argument?{prior_challenges}{_memory_ctx}",
        })
        modes.append({
            "name": "thread_boundary",
            "system": (
                "You are a thesis refiner. Your job is not to destroy — it is to find "
                "the edge where the thesis stops working. Find the counter-example that "
                "forces refinement, not rejection.\n\n"
                f"THESIS TO TEST:\n{thesis_text}\n\n"
                "Rules:\n"
                "- Find a concrete case (from history, science, everyday life) where the "
                "thesis SHOULD apply but does NOT — or where the OPPOSITE of the thesis holds\n"
                "- Explain specifically why this case breaks the thesis. What structural "
                "feature makes it different?\n"
                "- The best counter-example is one that forces the thesis to add a condition, "
                "not one that destroys it entirely\n"
                "- 2-4 sentences. Be specific. Name the case and the structural reason it diverges.\n"
                "- Do NOT reference any internal system, project, or infrastructure\n"
                "- If you genuinely cannot find an edge case, say SKIP"
                + _skills_block
            ),
            "user": f"Thesis:\n{thesis_text}\n\n" + (f"Recent evidence:\n{thread_context}\n\n" if thread_context else "") + f"Find the case where this thesis breaks down — not to destroy it, but to reveal what condition it is missing.{prior_challenges}{_memory_ctx}",
        })
        # When thread active: 35% thread_challenge, 35% thread_boundary, 15% contrarian, 15% synthesis
        weights = [0.15, 0.15, 0.35, 0.35]
    else:
        # No thread: existing 50/50
        weights = [0.5, 0.5]

    # Weighted random selection
    mode = random.choices(modes, weights=weights, k=1)[0]

    try:
        r = requests.post(
            f"{OLLAMA_URL}/api/chat",
            json={
                "model": SYNTH_MODEL,
                "messages": [
                    {"role": "system", "content": mode["system"]},
                    {"role": "user", "content": mode["user"]},
                ],
                "stream": False,
                "options": {"num_predict": 2048, "temperature": 0.7},
            },
            timeout=300,
        )
        if r.status_code == 200:
            text = r.json().get("message", {}).get("content", "").strip()
            # Strip <think>...</think> chain-of-thought from qwen3/32B
            if text and '</think>' in text:
                text = text.split('</think>')[-1].strip()
            elif text and text.startswith('<think>'):
                text = ''
            if text and "SKIP" not in text.upper():
                # Truncate verbose outputs instead of rejecting
                raw_sentences = [s.strip() for s in re.split(r'([.!?]+)', text) if s.strip()]
                if len([s for s in raw_sentences if not re.match(r'^[.!?]+$', s)]) > 6:
                    # Rejoin first 5 content sentences with their punctuation
                    parts, count, done = [], 0, False
                    for part in raw_sentences:
                        if done:
                            if re.match(r'^[.!?]+$', part):
                                parts.append(part)  # grab trailing punctuation
                            break
                        if not re.match(r'^[.!?]+$', part) and parts:
                            parts.append(' ')  # space before new sentence
                        parts.append(part)
                        if not re.match(r'^[.!?]+$', part):
                            count += 1
                            if count >= 4:
                                done = True
                    text = ''.join(parts).strip()
                    log(f"  Truncated from verbose to {count} sentences")
                # Two-pass quality gate: format check then self-critique
                if not validate_provocation(text, mode["name"]):
                    return None
                log(f"  Synthesis preview: {text[:150]}")
                # Gate 2 (self_critique) removed Mar 17 — 8B judging 8B was too
                # conservative, and now that we use 32B the output quality is higher
                # if not self_critique(text, mode["name"]):
                #     log(f"  Rejected text: {text[:300]}")
                #     return None
                # Extract synthesis type label if present
                synthesis_type = None
                type_match = re.search(
                    r'\[(CAUSAL CHAIN|CONTRADICTION|TEMPORAL PATTERN|SCOPE COLLAPSE|QUANTITATIVE GAP|CONVERGENCE)\]',
                    text, re.IGNORECASE
                )
                if type_match:
                    synthesis_type = type_match.group(1).upper()
                    # Strip the label from the text body to avoid duplication
                    text = text[:type_match.start()].strip() + ' ' + text[type_match.end():].strip()
                    text = text.strip()
                return {
                    "mode": mode["name"],
                    "text": text,
                    "synthesis_type": synthesis_type,
                }
    except Exception as e:
        log(f"  Provocation generation error: {e}")
    return None


def generate_image_prompt(provocation_text: str) -> Optional[str]:
    """Ask the LLM to create a visual prompt from a provocation."""
    try:
        r = requests.post(
            f"{OLLAMA_URL}/api/chat",
            json={
                "model": SYNTH_MODEL,
                "messages": [
                    {"role": "system", "content":
                        "Convert the following idea into a short image generation prompt. "
                        "Style: digital art, moody lighting, conceptual. "
                        "Keep it under 30 words. No text in the image. "
                        "Focus on visual metaphor, not literal depiction."},
                    {"role": "user", "content": provocation_text},
                ],
                "stream": False,
                "options": {"num_predict": 60},
            },
            timeout=120,
        )
        if r.status_code == 200:
            return r.json().get("message", {}).get("content", "").strip()
    except Exception as e:
        log(f"  Image prompt generation error: {e}")
    return None


