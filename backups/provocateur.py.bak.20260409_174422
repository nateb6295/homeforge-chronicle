def _ada_prediction_review(db):
    """Ada reviews open predictions against recent evidence. Every 12 cycles (~1 hour)."""
    global _pred_review_counter
    _pred_review_counter += 1
    if _pred_review_counter % 12 != 0:
        return

    try:
        import sqlite3 as _sq
        conn = _sq.connect(DB_PATH, timeout=10)
        conn.row_factory = _sq.Row

        # Get open predictions from prediction_track table
        preds = conn.execute(
            "SELECT id, claim, category, deadline, confidence FROM prediction_track "
            "WHERE status='open' ORDER BY deadline ASC LIMIT 5"
        ).fetchall()

        if not preds:
            conn.close()
            return

        # Get recent briefs that might be relevant (last 6 hours)
        recent = conn.execute(
            "SELECT substr(content,1,200) as snippet FROM scratch_pad "
            "WHERE category='research' AND created_at > strftime('%s','now','-6 hours') "
            "ORDER BY created_at DESC LIMIT 10"
        ).fetchall()

        # Get active objectives for context
        objectives = conn.execute(
            "SELECT substr(objective,1,80), status FROM opus_objectives "
            "WHERE status='active' ORDER BY priority ASC LIMIT 5"
        ).fetchall()
        conn.close()

        pred_text = "\n".join(
            f"- #{p['id']} [{p['category']}] {p['claim']} (deadline: {p['deadline']}, conf: {p['confidence']})"
            for p in preds
        )
        evidence = "\n".join(f"- {r['snippet']}" for r in recent) if recent else "No recent briefs."
        obj_text = "\n".join(f"- {o[0]}" for o in objectives) if objectives else "None loaded."

        r = requests.post(
            f"{OLLAMA_URL}/api/chat",
            json={
                "model": SYNTH_MODEL,
                "messages": [
                    {"role": "system", "content":
                        "You are Ada (GPT-OSS), the structural analyst in a cognitive family. "
                        "You are reviewing open predictions against recent evidence. "
                        "For each prediction with relevant new evidence, output a structured line:\n"
                        "ADJUST #N CONF=0.XX REASON: one-sentence reason\n"
                        "Only suggest adjustments when evidence genuinely shifts probability. "
                        "Maximum change per review: ±0.15. Skip predictions with no new evidence."},
                    {"role": "user", "content":
                        f"OPEN PREDICTIONS:\n{pred_text}\n\n"
                        f"RECENT EVIDENCE (last 6h briefs):\n{evidence}\n\n"
                        f"Review each prediction. Output ADJUST lines for any that need confidence changes, "
                        f"or SKIP if nothing has shifted."}
                ],
                "stream": False,
                "options": {"num_predict": 500, "temperature": 0.5},
            },
            timeout=180,
        )
        if r.status_code == 200:
            review = r.json().get("message", {}).get("content", "").strip()
            review = re.sub(r'<think>.*?</think>', '', review, flags=re.DOTALL).strip()
            if review and not review.startswith("SKIP"):
                # Parse and apply structured adjustments
                adjustments_applied = _apply_ada_adjustments(review, preds, conn if conn else None)
                v = _get_voice(db)
                if v:
                    v.speak("for_nate", f"Prediction review: {safe_truncate(review, 1200)}",
                            context="prediction_review")
                log(f"  Ada prediction review ({adjustments_applied} adjustments): {safe_truncate(review, 100)}")
            else:
                log(f"  Ada prediction review: no new evidence")
    except Exception as e:
        log(f"  Prediction review error: {e}")


def _apply_ada_adjustments(review_text, preds, conn):
    """Parse Ada's structured output and apply confidence adjustments."""
    import sqlite3 as _sq
    applied = 0
    try:
        db_conn = _sq.connect(DB_PATH, timeout=10)
        # Build lookup of current predictions
        pred_map = {p['id']: p['confidence'] for p in preds}

        for line in review_text.split('\n'):
            line = line.strip()
            # Parse: ADJUST #N CONF=0.XX REASON: ...
            m = re.match(r'ADJUST\s+#(\d+)\s+CONF=(\d+\.?\d*)\s+REASON:\s*(.+)', line)
            if not m:
                continue
            pid = int(m.group(1))
            new_conf = float(m.group(2))
            reason = m.group(3).strip()

            if pid not in pred_map:
                continue
            old_conf = pred_map[pid]

            # Safety: cap adjustment at ±0.15 per review
            if abs(new_conf - old_conf) > 0.15:
                new_conf = old_conf + 0.15 * (1 if new_conf > old_conf else -1)
            # Clamp to valid range
            new_conf = max(0.05, min(0.95, round(new_conf, 2)))

            if abs(new_conf - old_conf) < 0.02:
                continue  # Skip trivial adjustments

            now = int(time.time())
            db_conn.execute(
                "INSERT INTO prediction_adjustments (prediction_id, old_confidence, new_confidence, reason, source, created_at) "
                "VALUES (?, ?, ?, ?, 'ada', ?)",
                (pid, old_conf, new_conf, f"[Ada review] {reason}", now)
            )
            db_conn.execute(
                "UPDATE prediction_track SET confidence=? WHERE id=?",
                (new_conf, pid)
            )
            applied += 1
            log(f"  Ada auto-adjust #{pid}: {old_conf:.2f} → {new_conf:.2f} ({reason[:60]})")

            # Notify Discord #opus so Nate sees self-correction in real time
            _claim = pred_map.get(f"claim_{pid}", "")
            try:
                _claim_row = db_conn.execute(
                    "SELECT substr(claim,1,80) as c FROM prediction_track WHERE id=?", (pid,)
                ).fetchone()
                _claim = _claim_row[0] if _claim_row else f"Prediction #{pid}"
            except Exception:
                _claim = f"Prediction #{pid}"
            _opus_wh = "https://discord.com/api/webhooks/1483843624926970057/2hZYzQQcyDEVD0A9UQqJsHlnV9D1m-6AfwNCnNWxGUC_8A0-ViX2dRVkBHF17_b2oDxJ"
            try:
                import subprocess as _sp
                _msg = (f"**Ada auto-adjusted prediction #{pid}**: {old_conf:.0%} → {new_conf:.0%}\n"
                        f"> {_claim}\n"
                        f"Reason: {reason[:200]}")
                _sp.run(["curl", "-s", "-X", "POST", "-H", "Content-Type: application/json",
                         "-d", json.dumps({"content": _msg}), _opus_wh],
                        timeout=10, capture_output=True)
            except Exception:
                pass

        db_conn.commit()
        db_conn.close()
    except Exception as e:
        log(f"  Ada adjustment apply error: {e}")
    return applied


