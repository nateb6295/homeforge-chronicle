_topic_rel_cache = {"data": None, "ts": 0}

def _build_topic_relevance(db):
    """Keyword→avg_relevance from watcher scores on intern/provocateur output. Cached 15min."""
    now = int(time.time())
    if _topic_rel_cache["data"] is not None and now - _topic_rel_cache["ts"] < 900:
        return _topic_rel_cache["data"]

    rows = db.query(
        "SELECT ws.relevance, af.title FROM watcher_scores ws "
        "JOIN activity_feed af ON ws.feed_id = af.id "
        "WHERE ws.source IN ('intern','provocateur') AND ws.scored_at > ? "
        "ORDER BY ws.id DESC LIMIT 300",
        (now - 7 * 86400,)
    )
    if not rows:
        _topic_rel_cache["data"] = {}
        _topic_rel_cache["ts"] = now
        return {}

    _stop = {
        "research", "brief", "deep", "dive", "the", "and", "for", "with",
        "from", "that", "this", "what", "how", "provocateur", "contrarian",
        "synthesis", "claim", "dependency", "assumption", "about", "into",
        "over", "will", "have", "been", "their", "there", "more", "than",
        "https", "status",
    }
    kw_scores = {}
    for r in rows:
        title = re.sub(r'^(research brief|deep dive|provocateur \[\w+\]):\s*', '',
                       (r.get("title") or "").lower())
        title = re.sub(r'https?://\S+', '', title)
        words = [w for w in re.findall(r'[a-z]{4,}', title) if w not in _stop]
        rel = r["relevance"]
        for w in set(words):
            kw_scores.setdefault(w, []).append(rel)

    profile = {kw: sum(s)/len(s) for kw, s in kw_scores.items() if len(s) >= 3}
    _topic_rel_cache["data"] = profile
    _topic_rel_cache["ts"] = now
    return profile


_pred_kw_cache = {"data": None, "ts": 0}

def _get_prediction_keywords():
    """Keywords from active predictions — these topics must not be suppressed."""
    now = int(time.time())
    if _pred_kw_cache["data"] is not None and now - _pred_kw_cache["ts"] < 900:
        return _pred_kw_cache["data"]
    try:
        import sqlite3 as _sq
        _c = _sq.connect(DB_PATH, timeout=10)
        _preds = _c.execute("SELECT claim, category FROM prediction_track WHERE status='open'").fetchall()
        _c.close()
        _stop = {"will", "the", "that", "this", "with", "from", "have", "been", "before", "after", "through", "more", "than"}
        kws = set()
        for claim, cat in _preds:
            for w in re.findall(r'[a-z]{4,}', (claim or "").lower()):
                if w not in _stop:
                    kws.add(w)
            if cat:
                kws.add(cat.lower())
        _pred_kw_cache["data"] = kws
        _pred_kw_cache["ts"] = now
    except Exception:
        _pred_kw_cache["data"] = set()
        _pred_kw_cache["ts"] = now
    return _pred_kw_cache["data"]


def _score_title_relevance(title, profile):
    """Score title against learned relevance profile. Prediction-protected."""
    if not profile or not title:
        return 0.0
    words = set(re.findall(r'[a-z]{4,}', title.lower()))
    matched = [(profile[w] - 3.0) / 2.0 for w in words if w in profile]
    score = sum(matched) / len(matched) if matched else 0.0
    # Prediction protection: don't suppress prediction-relevant topics
    if score < 0.0:
        pred_kws = _get_prediction_keywords()
        if pred_kws and words & pred_kws:
            return 0.0
    return score


