def _load_active_thread_raw():
    """Load the primary active cognitive thread directly from DB, including latest thesis."""
    import sqlite3 as _sq
    try:
        conn = _sq.connect(DB_PATH, timeout=10)
        conn.row_factory = _sq.Row
        row = conn.execute(
            "SELECT id, title, question, context FROM cognitive_threads "
            "WHERE status='active' ORDER BY priority LIMIT 1"
        ).fetchone()
        if row:
            thread = dict(row)
            # Fetch the latest advancement as the concrete thesis to challenge
            adv = conn.execute(
                "SELECT content FROM thread_history "
                "WHERE thread_id = ? AND event_type = 'advanced' "
                "ORDER BY created_at DESC LIMIT 1",
                (thread["id"],)
            ).fetchone()
            thread["thesis"] = adv["content"][:500] if adv else (thread["context"] or thread["question"])
            conn.close()
            return thread
        conn.close()
        return None
    except Exception:
        return None

