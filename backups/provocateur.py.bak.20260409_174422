def _ada_fetch_raw(url, timeout=10):
    """Fetch a URL and return cleaned text content."""
    import httpx
    import re as _re
    try:
        r = httpx.get(url, timeout=timeout, follow_redirects=True, headers={
            "User-Agent": "Mozilla/5.0 (compatible; Chronicle-Ada/1.0)"
        })
        if r.status_code != 200:
            return None
        text = r.text
        if "JavaScript" in text and "enable JavaScript" in text:
            try:
                from playwright.sync_api import sync_playwright
                with sync_playwright() as p:
                    browser = p.chromium.launch(headless=True)
                    page = browser.new_page()
                    page.set_default_timeout(10000)
                    page.goto(url, wait_until="domcontentloaded")
                    page.wait_for_timeout(1500)
                    text = page.inner_text("body")
                    browser.close()
            except Exception:
                return None
        else:
            text = _re.sub(r'<(script|style)[^>]*>.*?</\1>', '', text, flags=_re.DOTALL | _re.IGNORECASE)
            text = _re.sub(r'<[^>]+>', ' ', text)
            text = _re.sub(r'\s+', ' ', text).strip()
        return text if text else None
    except Exception as e:
        log(f"  Ada fetch error ({url[:60]}): {e}")
        return None


def _ada_fetch_url(url):
    """Ada fetches URL content for deeper capture analysis.

    For X/Twitter URLs: fetches tweet via vxtwitter API, THEN follows any
    embedded article links to get the actual source material Nate is pointing at.
    """
    import re as _re

    tweet_text = ""
    article_text = ""

    if "x.com/" in url or "twitter.com/" in url:
        # ── Step 1: Get tweet content via vxtwitter API (JSON) ──
        # vxtwitter works; fxtwitter is Cloudflare-blocked as of 2026-03-30
        api_url = _re.sub(r'https?://(x\.com|twitter\.com)/', 'https://api.vxtwitter.com/', url)
        api_url = api_url.split('?')[0]
        try:
            import httpx
            r = httpx.get(api_url, timeout=10, follow_redirects=True)
            if r.status_code == 200:
                data = r.json()
                # vxtwitter returns flat structure (not nested under "tweet")
                tweet_text = data.get("text", "")
                author = data.get("user_name", "")
                if author:
                    tweet_text = f"@{author}: {tweet_text}"

                # ── Step 2: Extract article URLs from tweet text ──
                # vxtwitter embeds URLs directly in the text field
                embedded_urls = []

                # Regex scan tweet text for non-Twitter URLs
                text_urls = _re.findall(r'https?://[^\s)\]]+', tweet_text)
                for u in text_urls:
                    # Skip twitter/x.com self-references and pic links
                    if any(d in u for d in ['x.com', 'twitter.com', 't.co', 'pbs.twimg', 'vxtwitter']):
                        continue
                    if u not in embedded_urls:
                        embedded_urls.append(u)

                # ── Step 3: Fetch the first real article URL ──
                for article_url in embedded_urls[:2]:  # try up to 2
                    # Skip image/video URLs
                    if any(ext in article_url.lower() for ext in ['.jpg', '.png', '.gif', '.mp4', '.webp']):
                        continue
                    log(f"  Ada following article link: {article_url[:80]}")
                    fetched = _ada_fetch_raw(article_url, timeout=12)
                    if fetched and len(fetched) > 200:
                        article_text = fetched[:3000]
                        break

        except Exception as e:
            log(f"  Ada vxtwitter API error: {e}")
            # Fall back to HTML fetch via vxtwitter
            fallback_url = url.replace("x.com/", "vxtwitter.com/").replace("twitter.com/", "vxtwitter.com/")
            tweet_text = _ada_fetch_raw(fallback_url) or ""
            tweet_text = tweet_text[:1500]

        # ── Combine: tweet context + article substance ──
        result = ""
        if tweet_text:
            result = f"TWEET: {tweet_text[:500]}"
        if article_text:
            result += f"\n\nARTICLE CONTENT:\n{article_text}"
        elif tweet_text:
            result += "\n\n(No article link found in tweet — analysis based on tweet text only)"
        return result if result else None

    else:
        # Non-Twitter URL — fetch directly with higher limit
        text = _ada_fetch_raw(url)
        return text[:3000] if text else None


