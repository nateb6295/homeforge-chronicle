        "embedding gap", "capsule store", "capsule retrieval",
        "multi-layered capsule", "attention-based retrieval",
    ]
    for term in _INTERNAL_TERMS:
        if term in lower:
            log(f"  Rejected: self-referential ('{term}')")
            return False

    return True


