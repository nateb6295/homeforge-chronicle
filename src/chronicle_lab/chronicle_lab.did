type ExperimentStatus = variant {
    Proposed;
    Running;
    Paused;
    Completed;
    Failed;
    Abandoned;
};

type Observation = record {
    timestamp : nat64;
    content : text;
    data : opt text;
    source : text;
};

type ExperimentResult = record {
    outcome : text;
    summary : text;
    learnings : vec text;
    next_steps : vec text;
    completed_at : nat64;
};

type Experiment = record {
    id : nat64;
    title : text;
    hypothesis : text;
    method : text;
    status : ExperimentStatus;
    observations : vec Observation;
    result : opt ExperimentResult;
    tags : vec text;
    created_at : nat64;
    updated_at : nat64;
};

type ArchComponent = record {
    name : text;
    purpose : text;
    implementation_notes : text;
    estimated_effort : text;
    priority : nat32;
};

type ProposalStatus = variant {
    Draft;
    UnderReview;
    Approved;
    Implementing;
    Implemented;
    Superseded;
};

type ArchProposal = record {
    id : nat64;
    title : text;
    version : nat32;
    description : text;
    components : vec ArchComponent;
    status : ProposalStatus;
    rationale : text;
    tradeoffs : vec text;
    created_at : nat64;
    updated_at : nat64;
};

type CognitiveBenchmark = record {
    id : nat64;
    cycle_id : text;
    timestamp : nat64;
    model_used : text;
    prompt_tokens : nat64;
    response_tokens : nat64;
    action_diversity : float64;
    rumination_score : float64;
    reasoning_quality : float64;
    actions_taken : vec text;
    config_variant : opt text;
    notes : opt text;
};

type ResearchNote = record {
    id : nat64;
    title : text;
    content : text;
    source : text;
    tags : vec text;
    connections : vec nat64;
    created_at : nat64;
};

type LabStats = record {
    experiment_count : nat64;
    active_experiments : nat64;
    proposal_count : nat64;
    benchmark_count : nat64;
    note_count : nat64;
    created_at : nat64;
};

type HttpRequest = record {
    method : text;
    url : text;
    headers : vec record { text; text };
    body : blob;
};

type HttpResponse = record {
    status_code : nat16;
    headers : vec record { text; text };
    body : blob;
};

service : {
    // Experiments
    create_experiment : (text, text, text, vec text) -> (nat64);
    start_experiment : (nat64) -> (bool);
    add_observation : (nat64, text, opt text, text) -> (bool);
    complete_experiment : (nat64, text, text, vec text, vec text) -> (bool);
    get_experiment : (nat64) -> (opt Experiment) query;
    list_experiments : (opt text) -> (vec Experiment) query;

    // Architecture Proposals
    create_proposal : (text, text, vec ArchComponent, text, vec text) -> (nat64);
    update_proposal_status : (nat64, text) -> (bool);
    get_proposal : (nat64) -> (opt ArchProposal) query;
    list_proposals : () -> (vec ArchProposal) query;

    // Benchmarks
    record_benchmark : (text, text, nat64, nat64, float64, float64, float64, vec text, opt text, opt text) -> (nat64);
    get_benchmarks : (nat64) -> (vec CognitiveBenchmark) query;
    benchmark_summary : () -> (text) query;

    // Research Notes
    add_note : (text, text, text, vec text) -> (nat64);
    connect_notes : (nat64, nat64) -> (bool);
    get_note : (nat64) -> (opt ResearchNote) query;
    search_notes : (text) -> (vec ResearchNote) query;

    // Stats
    lab_stats : () -> (LabStats) query;

    // HTTP
    http_request : (HttpRequest) -> (HttpResponse) query;
}
