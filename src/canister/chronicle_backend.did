type AgentIdentity = record {
  http_endpoint : opt text;
  capabilities : vec text;
  name : text;
  canister_id : principal;
  description : opt text;
  agent_type : text;
};
type AgentMessage = record {
  id : nat64;
  content : text;
  subject : opt text;
  msg_type : MessageType;
  metadata : opt text;
  read : bool;
  sender : AgentIdentity;
  expects_reply : bool;
  timestamp : nat64;
  replied : bool;
  thread_id : nat64;
  in_reply_to : opt nat64;
};
type CapsuleEmbedding = record {
  capsule_id : nat64;
  model_name : text;
  embedding : vec float32;
};
type ConversationThread = record {
  id : nat64;
  participants : vec principal;
  subject : text;
  created_at : nat64;
  message_count : nat64;
  last_activity : nat64;
};
type EvmChain = variant { Base; Ethereum; Flare };
type HeartbeatRecord = record {
  timestamp : nat64;
  embedding_count : nat64;
  capsule_count : nat64;
  reflection : opt text;
};
type HeartbeatStatus = record {
  is_alive : bool;
  interval_secs : nat64;
  last_heartbeat : opt nat64;
  total_heartbeats : nat64;
  capsule_count : nat64;
};
type HttpHeader = record { value : text; name : text };
type HttpRequest = record {
  url : text;
  method : text;
  body : blob;
  headers : vec record { text; text };
};
type HttpResponse = record {
  body : blob;
  headers : vec record { text; text };
  upgrade : opt bool;
  status_code : nat16;
};
type HttpResponse_1 = record {
  status : nat;
  body : blob;
  headers : vec HttpHeader;
};
type KnowledgeCapsule = record {
  id : nat64;
  topic : opt text;
  conversation_id : text;
  created_at : nat64;
  keywords : vec text;
  restatement : text;
  persons : vec text;
  entities : vec text;
  timestamp : opt text;
  confidence_score : float64;
  location : opt text;
};
type MarketState = record {
  last_swap_at : opt nat64;
  xrp_prices : vec PricePoint;
  swaps_24h : float64;
  xrp_rsi : opt float64;
};
type MessageType = variant {
  Conversation;
  ResearchTask;
  Information;
  ActionRequest;
  GoalAssignment;
  Query;
};
type MindCognitiveState = record {
  updated_at : nat64;
  constraints : vec text;
  semantic_gist : text;
  goal_orientation : text;
  version : nat64;
  predictive_cue : text;
  episodic_trace : vec text;
};
type MindNote = record {
  id : nat64;
  resolved : bool;
  content : text;
  created_at : nat64;
  category : text;
  priority : nat8;
};
type MindOutboxMessage = record {
  id : nat64;
  created_at : nat64;
  acknowledged : bool;
  message : text;
  priority : nat8;
};
type MindState = record {
  outbox : vec MindOutboxMessage;
  cognitive_state : MindCognitiveState;
  next_thought_id : nat64;
  next_note_id : nat64;
  next_outbox_id : nat64;
  notes : vec MindNote;
  market : MarketState;
  thoughts : vec MindThought;
};
type MindThought = record {
  id : nat64;
  context_summary : text;
  reasoning_summary : text;
  created_at : nat64;
  cycle_id : text;
  actions_taken : vec text;
};
type PricePoint = record {
  source : text;
  timestamp : nat64;
  price_usd : float64;
};
type RegisteredAgent = record {
  trust_level : nat8;
  notes : opt text;
  identity : AgentIdentity;
  registered_at : nat64;
  last_contact : opt nat64;
};
type SearchResult = record { score : float64; capsule : KnowledgeCapsule };
type TransformArgs = record { context : blob; response : HttpResponse_1 };
type TrustSetParams = record {
  limit : text;
  issuer : text;
  currency : text;
  last_ledger_sequence : nat32;
  fee_drops : nat64;
  sequence : nat32;
};
type EscrowCreateParams = record {
  destination : text;
  amount_drops : nat64;
  fee_drops : nat64;
  sequence : nat32;
  last_ledger_sequence : nat32;
  finish_after : opt nat32;
  cancel_after : opt nat32;
  condition : opt text;
  destination_tag : opt nat32;
};
type EscrowFinishParams = record {
  owner : text;
  offer_sequence : nat32;
  fee_drops : nat64;
  sequence : nat32;
  last_ledger_sequence : nat32;
  condition : opt text;
  fulfillment : opt text;
};
type XrpPaymentParams = record {
  destination : text;
  last_ledger_sequence : nat32;
  amount_drops : nat64;
  fee_drops : nat64;
  sequence : nat32;
};
service : () -> {
  // Acknowledge all outbox messages
  acknowledge_all_mind_messages : () -> (nat64);
  // Acknowledge an outbox message
  acknowledge_mind_message : (nat64) -> (bool);
  // Add a goal for the agent to pursue
  add_agent_goal : (text, opt nat8) -> (text);
  // Add a new knowledge capsule
  add_capsule : (
      text,
      text,
      opt text,
      opt text,
      opt text,
      float64,
      vec text,
      vec text,
      vec text,
    ) -> (nat64);
  // Bulk add capsules (more efficient)
  add_capsules_bulk : (vec KnowledgeCapsule) -> (vec nat64);
  // Add embedding for a capsule
  add_embedding : (nat64, vec float32, text) -> (bool);
  // Bulk add embeddings (more efficient)
  add_embeddings_bulk : (vec CapsuleEmbedding) -> (nat64);
  // Add a scratch pad note
  add_mind_note : (text, text, nat8) -> (nat64);
  // Add a price data point
  add_mind_price : (float64, text) -> ();
  // Add a thought to the stream
  add_mind_thought : (text, text, text, vec text) -> (nat64);
  // Get inbox messages
  agent_get_inbox : (bool, nat64) -> (vec AgentMessage) query;
  // Get outbox messages (sent messages)
  agent_get_outbox : (nat64) -> (vec AgentMessage) query;
  // Get a specific thread with all messages
  agent_get_thread : (nat64) -> (text) query;
  // Get list of known agents
  agent_list_known : () -> (vec RegisteredAgent) query;
  // Get list of conversation threads
  agent_list_threads : (nat64) -> (vec ConversationThread) query;
  // Mark a message as read
  agent_mark_read : (nat64) -> (bool);
  // Get messaging stats
  agent_messaging_stats : () -> (text) query;
  // Register a known agent (for discovery)
  agent_register : (
      principal,
      text,
      text,
      opt text,
      vec text,
      opt text,
      opt text,
      nat8,
    ) -> (text);
  // Reply to a message
  agent_reply : (nat64, text) -> (text);
  // Send a message to another agent via HTTP outcall
  // This enables proactive outreach to agents with HTTP endpoints
  agent_send_http_message : (text, text, text, opt text, text, bool) -> (text);
  // Send a message to this agent (anyone can call this)
  agent_send_message : (
      text,
      text,
      opt principal,
      text,
      opt text,
      text,
      opt nat64,
      opt nat64,
      bool,
    ) -> (text);
  // Cancel pending research tasks by pattern (owner only)
  // Removes tasks where query contains the pattern (case-insensitive)
  cancel_research_by_pattern : (text) -> (text);
  // Manually trigger pending transaction check (owner only)
  // Useful for debugging or forcing a status update
  check_pending_tx_status : () -> (text);
  // Clear pending accumulation transaction (after successful submission)
  clear_pending_accumulation_tx : () -> (text);
  // Manually clear a pending transaction (owner only)
  // Use when a transaction has expired or failed and the auto-detection didn't catch it
  clear_pending_transaction : () -> (text);
  // Configure autonomous accumulation (owner only)
  // This enables Chronicle to autonomously swap XRP to RLUSD during heartbeat
  configure_accumulation : (bool, nat64, nat64) -> (text);
  // Configure LLM for autonomous reflection (owner only)
  // Now uses DFINITY's LLM Canister - no API keys needed!
  configure_llm : (bool, opt text) -> (bool);
  // Configure notification system (owner only)
  // This enables Chronicle to reach out to the human via ntfy.sh
  configure_notifications : (bool, text, nat64) -> (text);
  // Configure research task system (owner only)
  configure_research : (bool) -> (text);
  // Confirm successful accumulation - increments count and sequence, clears pending
  // Call this after successfully submitting the pending transaction
  confirm_accumulation_success : (opt nat64, opt text) -> (text);
  // Get a comprehensive dashboard view of canister state
  // This is the primary visibility endpoint for the operator to see what's happening
  dashboard : () -> (text) query;
  // Deduplicate pending research tasks (owner only)
  // Removes duplicate queries from the pending queue, keeping the oldest
  dedupe_research_queue : () -> (text);
  // Delete capsules by ID (owner only) - for cleaning up garbage data
  // Returns number of capsules actually deleted
  delete_capsules : (vec nat64) -> (text);
  // Simple feed input - for humans to submit info directly to Chronicle
  // Returns JSON with capsule_id and status
  feed_input : (text, opt text) -> (text);
  // Get accumulation status
  get_accumulation_status : () -> (text) query;
  // Get recent activity log entries
  get_activity_log : (nat64) -> (text) query;
  // Get the agent's current goals
  get_agent_goals : () -> (text) query;
  // Get the agent's inbox (pending messages)
  get_agent_inbox : (bool) -> (text) query;
  // Get responses from the agent's outbox
  get_agent_responses : (nat64, bool) -> (text) query;
  // Get the agent's current status
  get_agent_status : () -> (text) query;
  // Get all embeddings (for client-side semantic search)
  get_all_embeddings : () -> (vec CapsuleEmbedding) query;
  // Get a specific capsule by ID
  get_capsule : (nat64) -> (opt KnowledgeCapsule) query;
  // Get capsule count
  get_capsule_count : () -> (nat64) query;
  // Get comprehensive dashboard data as JSON
  get_dashboard : () -> (text) query;
  // Get embedding for a specific capsule
  get_embedding : (nat64) -> (opt CapsuleEmbedding) query;
  // Get embedding count
  get_embedding_count : () -> (nat64) query;
  // Get Chronicle's EVM wallet address (derived from same key as XRP)
  // This address works on BASE, Flare, Ethereum, and all EVM chains
  get_evm_address : () -> (text) query;
  // Get ETH/native token balance on an EVM chain via HTTP outcall
  get_evm_balance : (EvmChain) -> (text);
  // Get recent heartbeat history
  get_heartbeat_history : () -> (vec HeartbeatRecord) query;
  // Get heartbeat status - shows autonomous operation state
  get_heartbeat_status : () -> (HeartbeatStatus) query;
  // Get LLM configuration status
  get_llm_status : () -> (text) query;
  // Get our messaging identity
  get_messaging_identity : () -> (opt AgentIdentity) query;
  // Get cognitive state only
  get_mind_cognitive_state : () -> (opt MindCognitiveState) query;
  // Get scratch pad notes
  get_mind_notes : (bool) -> (vec MindNote) query;
  // Get outbox messages
  get_mind_outbox : (bool) -> (vec MindOutboxMessage) query;
  // Get the current mind state
  get_mind_state : () -> (opt MindState) query;
  // Get recent thoughts
  get_mind_thoughts : (nat64) -> (vec MindThought) query;
  // Get complete multi-chain wallet status
  // Shows addresses on XRP, BASE, Flare derived from the same key
  get_multichain_wallet : () -> (text) query;
  // Get notification status
  get_notification_status : () -> (text) query;
  // Get pending accumulation transaction (for manual submission)
  get_pending_accumulation_tx : () -> (text) query;
  // Get recent capsules
  get_recent_capsules : (nat64) -> (vec KnowledgeCapsule) query;
  // Get a specific research finding by ID
  get_research_finding : (nat64) -> (text) query;
  // Get all research findings (optionally filter by retrieved status)
  get_research_findings : (bool) -> (text) query;
  // Get research system status
  get_research_status : () -> (text) query;
  // Get research task status
  get_research_task : (nat64) -> (text) query;
  // Get transaction history - confirmed transactions
  get_transaction_history : (nat64) -> (text) query;
  // Get or fetch the XRP wallet address
  // This calls the management canister to get the public key if not cached
  get_wallet_address : () -> (text);
  // Get wallet status (cached info only, no management canister calls)
  get_wallet_status : () -> (text) query;
  // Health check
  health : () -> (text) query;
  // HTTP request handler - exposes REST API for cross-Claude access
  http_request : (HttpRequest) -> (HttpResponse) query;
  // HTTP update handler for POST requests (can modify state)
  http_request_update : (HttpRequest) -> (HttpResponse);
  // Initialize messaging with our identity
  init_messaging : (text, text, opt text, vec text) -> (text);
  // Initialize the kin agent with optional custom identity
  initialize_agent : (opt text, opt vec text, opt vec text) -> (text);
  // List pending research task queries (for debugging)
  list_pending_research : (opt nat32) -> (text) query;
  // LLM prompt relay - allows off-chain clients to use ICP LLM via the canister
  // This is the bridge for Chronicle Mind to use on-chain AI
  llm_prompt : (text, opt text, opt text) -> (text);
  // Mark research findings as retrieved
  mark_findings_retrieved : (vec nat64) -> (text);
  // Mark a response as retrieved
  mark_response_retrieved : (nat64) -> (text);
  // Record a swap for daily tracking
  record_mind_swap : (float64) -> ();
  // Resolve a scratch pad note
  resolve_mind_note : (nat64) -> (bool);
  // Search by keyword
  search_by_keyword : (text, nat64) -> (vec KnowledgeCapsule) query;
  // Search by person name
  search_by_person : (text, nat64) -> (vec KnowledgeCapsule) query;
  // Semantic search - find capsules similar to a query embedding
  // This runs cosine similarity directly on-chain
  semantic_search : (vec float32, nat64) -> (vec SearchResult) query;
  // Send a message to the outbox
  send_mind_message : (text, nat8) -> (nat64);
  // Manually send a notification (owner only, for testing)
  send_test_notification : (text, text) -> (text);
  // Send a message to the kin agent
  // Anyone can send messages, but the agent decides what to act on
  send_to_agent : (text, text, opt text, opt nat8) -> (text);
  // Set API token for HTTP access (owner only)
  set_api_token : (opt text) -> (bool);
  // Sign an EVM transaction using threshold ECDSA
  // Returns the signed transaction ready for broadcast
  sign_evm_transaction : (
      EvmChain,
      text,
      text,
      nat64,
      nat64,
      text,
      text,
      opt text,
    ) -> (text);
  // Sign an EscrowCreate transaction to lock XRP in escrow
  sign_escrow_create : (EscrowCreateParams) -> (text);
  // Sign an EscrowFinish transaction to release escrowed XRP
  sign_escrow_finish : (EscrowFinishParams) -> (text);
  // Sign a swap XRP -> RLUSD using immediate-or-cancel offer
  sign_swap_xrp_to_rlusd : (nat64, text, nat64, nat32, nat32) -> (text);
  // Sign a swap RLUSD -> XRP using immediate-or-cancel offer (buy XRP with RLUSD)
  sign_swap_rlusd_to_xrp : (nat64, text, nat64, nat32, nat32) -> (text);
  // Sign a TrustSet transaction to establish a trustline
  sign_trustset : (TrustSetParams) -> (text);
  // Sign an XRP payment transaction
  // Returns the signed transaction blob and hash
  sign_xrp_payment : (XrpPaymentParams) -> (text);
  // Store a thought from the cognitive loop
  store_mind_thought : (text, text, text, vec text) -> ();
  // Submit a research task for on-chain analysis
  // This is how Claude queues work for the on-chain research assistant
  // Can optionally include URLs to fetch for additional context
  submit_research_task : (text, opt text, opt nat32, opt vec text) -> (text);
  // Submit a signed transaction to XRPL via HTTP outcall
  submit_xrp_transaction : (text, opt text) -> (text);
  // Sync transaction history from XRPL (owner only)
  // Fetches recent transactions and populates transaction_history
  // Also updates accumulation_count based on actual on-chain OfferCreate transactions
  sync_transaction_history : (nat32) -> (text);
  // Sync wallet info from XRPL (owner only)
  // Fetches current balance and sequence from the ledger
  sync_wallet_from_xrpl : () -> (text);
  // Transform agent message responses for consensus
  // Normalizes responses from other agents' HTTP endpoints
  // Must produce identical output across all replicas
  transform_agent_response : (TransformArgs) -> (HttpResponse_1) query;
  // Transform EVM RPC responses for consensus
  transform_evm_response : (TransformArgs) -> (HttpResponse_1) query;
  // Transform ntfy responses to be deterministic across replicas
  // ntfy returns unique IDs and timestamps that differ per replica
  transform_ntfy_response : (TransformArgs) -> (HttpResponse_1) query;
  // Transform web fetch responses for consensus
  // Strips headers, keeps body content (HTML/JSON/text)
  transform_web_response : (TransformArgs) -> (HttpResponse_1) query;
  // Transform XRPL responses to be deterministic across replicas
  // Strips non-deterministic fields like headers and normalizes JSON
  transform_xrpl_response : (TransformArgs) -> (HttpResponse_1) query;
  // Trigger accumulation manually (for testing, owner only)
  // This bypasses the heartbeat check and directly attempts to sign a swap
  trigger_accumulation : () -> (text);
  // Manually trigger agent reasoning (owner only)
  trigger_agent_reasoning : () -> (text);
  // Trigger a reflection manually (for testing, owner only)
  trigger_reflection : () -> (text);
  // Manually trigger research task processing (doesn't wait for heartbeat)
  trigger_research : () -> (text);
  // Update cognitive state (replaces existing)
  update_mind_cognitive_state : (
      opt text,
      opt text,
      opt vec text,
      opt text,
      opt vec text,
    ) -> (bool);
  // Update wallet info from external source (called after checking account_info)
  // This allows the MCP or external service to keep the canister informed
  update_wallet_info : (opt nat64, opt text, opt nat32, opt nat32) -> (text);
  // Write a reflection directly from the cognitive loop (public - anyone can contribute reflections)
  write_reflection : (text, opt text) -> (nat64);
}
